{
  "appId": "com.masrofi.app",
  "appName": "مصروفي · Masrofi",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor"
  },
  "ios": {
    "contentInset": "never",
    "allowsLinkPreview": false,
    "scrollEnabled": false,
    "backgroundColor": "#070D19"
  },
  "android": {
    "backgroundColor": "#070D19",
    "allowMixedContent": true
  },
  "plugins": {
    "Camera": {
      "permissionsType": "prompt"
    }
  }
}
