# ============================================================================
# Masrofi (مصروفي) — إعدادات السيرفر، Supabase Realtime، والذكاء الاصطناعي
# انسخ هذا الملف إلى `.env` أو أدخل المفاتيح مباشرة من داخل التطبيق (الإعدادات -> الربط السحابي والذكاء الاصطناعي)
# ============================================================================

PORT=3000

# 1. إعدادات Supabase (مجاني ويدعم المزامنة اللحظية Realtime لجميع أفراد العائلة)
# احصل عليها من: https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 2. إعدادات الذكاء الاصطناعي لقراءة الفواتير والإيصالات بالكاميرا (مجاني ودائم)
# المزود الموصى به: gemini (عبر Google AI Studio المجاني: https://aistudio.google.com/apikey)
# يدعم أيضاً: groq (https://console.groq.com/keys) أو openrouter (https://openrouter.ai/keys)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=
